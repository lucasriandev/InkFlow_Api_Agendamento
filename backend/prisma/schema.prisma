generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Trabalho {
  id        Int      @id @default(autoincrement())
  estilo    String
  descricao String
  imagemUrl String?
  createdAt DateTime @default(now())
}

model Agendamento {
  id          Int      @id @default(autoincrement())
  nomeCliente String
  telefone    String
  dataHora    DateTime
  descricao   String
  status      String   @default("PENDENTE")
  createdAt   DateTime @default(now())
}